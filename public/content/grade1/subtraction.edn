{:id    "subtraction"
 :grade "grade1"
 :title "Subtraction"

 :sections
 [{:type :explanation
   :text "Subtraction means taking away from a group to find what is left."
   :math "7 - 3 = 4"}

  {:type :example
   :problem "8 - 5 = \\,?"
   :solution "8 - 5 = 3"
   :hint "Start at 8 and count back 5: 7, 6, 5, 4, 3."}

  {:type :example
   :problem "10 - 4 = \\,?"
   :solution "10 - 4 = 6"
   :hint "Think: 4 + ? = 10. The answer is 6."}]

 :quiz
 [{:id "q1"
   :question "7 - 3 = \\,?"
   :options [2 3 4 5]
   :answer  4}

  {:id "q2"
   :question "10 - 6 = \\,?"
   :options [3 4 5 6]
   :answer  4}

  {:id "q3"
   :question "9 - 2 = \\,?"
   :options [5 6 7 8]
   :answer  7}]}
