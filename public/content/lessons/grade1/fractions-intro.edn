{:id    "fractions"
 :grade "grade5"
 :title "Fractions"

 :sections
 [{:type :explanation
   :text "A fraction represents a part of a whole. The bottom number (denominator) tells us how many equal parts the whole is divided into. The top number (numerator) tells us how many parts we have."
   :math "\\frac{3}{4}"}

  {:type :example
   :problem "\\frac{1}{2} + \\frac{1}{4} = \\,?"
   :solution "\\frac{1}{2} + \\frac{1}{4} = \\frac{2}{4} + \\frac{1}{4} = \\frac{3}{4}"
   :hint "Convert ½ to quarters first: ½ = 2/4. Then add the numerators."}

  {:type :example
   :problem "\\frac{3}{5} + \\frac{1}{5} = \\,?"
   :solution "\\frac{3}{5} + \\frac{1}{5} = \\frac{4}{5}"
   :hint "Same denominator — just add the numerators: 3 + 1 = 4."}]

 :quiz
 [{:id "q1"
   :question "\\frac{1}{4} + \\frac{1}{4} = \\,?"
   :options ["1/2" "1/4" "2/8" "3/4"]
   :answer  "1/2"}

  {:id "q2"
   :question "\\frac{2}{3} + \\frac{1}{3} = \\,?"
   :options ["1/3" "2/3" "1" "3/3"]
   :answer  "1"}

  {:id "q3"
   :question "\\frac{3}{8} + \\frac{2}{8} = \\,?"
